PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=mysql://user:password@host:3306/dialab

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# GCS uploads
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-gcs-bucket-name

# Dr. Dia assistant
ASSISTANT_PROVIDER=hermes
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=replace-with-hermes-api-server-key
HERMES_MODEL=dr-dia-hermes
MISTRAL_API_KEY=replace-with-mistral-api-key
MISTRAL_AUDIO_TRANSCRIPTION_MODEL=voxtral-mini-latest

# Telegram Dr. Dia channel
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_OPERATOR_URL=https://t.me/your-operator-username
TELEGRAM_MINI_APP_URL=https://dialab.center/telegram/dr-dia

# WhatsApp Dr. Dia channel
WHATSAPP_ACCESS_TOKEN=replace-with-meta-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-meta-whatsapp-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-random-meta-verify-token
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEB_APP_BASE_URL=https://dialab.center/assistant
