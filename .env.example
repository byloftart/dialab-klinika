PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=mysql://user:password@host:3306/dialab

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# GCS uploads
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-gcs-bucket-name

# Dr. Dia assistant
ASSISTANT_PROVIDER=hermes
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=replace-with-hermes-api-server-key
HERMES_MODEL=dr-dia-hermes
